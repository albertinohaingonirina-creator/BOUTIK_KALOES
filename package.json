    "lint": "node ./node_modules/@angular/cli/bin/ng.js lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
