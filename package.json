    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "motion": "^12.23.24",
    "rxjs": "~7.8.0",
